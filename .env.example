# Database (PostgreSQL — free via Supabase: Project Settings > Database > Connection string)
# Pooled connection (port 6543, via pgbouncer) — used by the app at runtime on Vercel.
DATABASE_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used only for `prisma migrate`, which pgbouncer's transaction
# pooling mode can't run. Without this, migrations fail against a pooled Supabase connection.
DIRECT_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:5432/postgres"

# Google Gemini API (free via https://aistudio.google.com)
GEMINI_API_KEY=""
# Optional — overrides the default model name. Verify current free-tier Flash/Flash-Lite model
# names at https://ai.google.dev/gemini-api/docs/models before relying on the default below.
GEMINI_MODEL="gemini-flash-latest"

# Session / OTP signing secret — any long random string, e.g. `openssl rand -base64 32`.
# Signs both the login session cookie and the short-lived OTP challenge token (lib/session.ts).
SESSION_SECRET=""

# WhatsApp/SMS OTP gateway (e.g. Fonnte). Leave blank in development — the OTP code is logged to
# the server console instead (fixed code "000000" outside production; see README's demo login).
OTP_PROVIDER_API_KEY=""

# Supabase project (Project Settings > API) — used for Storage (report photos) and optionally
# Realtime notifications.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — SERVER-SIDE ONLY, bypasses Row Level Security. Never expose to the client
# and never prefix with NEXT_PUBLIC_. Needed for server-side Storage uploads in lib/supabase.ts.
SUPABASE_SERVICE_ROLE_KEY=""

# App base URL (used for callbacks/notification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
